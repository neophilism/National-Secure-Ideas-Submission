ENGINE_IMAGE=ghcr.io/neophilism/secure-intake-case-workflow-engine:1.0.0-rc.4
APP_BASE_URL=http://localhost:3000
APP_PORT=3000

POSTGRES_USER=sig
POSTGRES_PASSWORD=replace-with-a-development-password
POSTGRES_DB=sig

AUTH_SESSION_COOKIE_NAME=sig_session

# External participant portal session. This is separate from staff authentication.
PARTICIPANT_SESSION_COOKIE_NAME=sig_participant_session
PARTICIPANT_SESSION_TTL_HOURS=8

AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_BLOCK_MINUTES=15
AUTH_TRUST_PROXY_HEADERS=false

# Required only when webhook subscriptions are enabled. Use 64 hex characters.
WEBHOOK_ENCRYPTION_KEY=

# Required because this SIG manifest uses protected identity fields.
# DEVELOPMENT EXAMPLE ONLY. Replace with a securely generated 32-byte key
# (64 hexadecimal characters) and manage production values as secrets.
PROTECTED_DATA_ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111

BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-development-password
