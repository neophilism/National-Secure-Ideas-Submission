  "forms": [
    {
      "slug": "secure-idea-submission",
      "name": "Secure Innovation Gateway Submission",
      "description": "Foundation unclassified intake for anonymous national-security-relevant submissions. Protected identity/contact intake and public attachments are intentionally deferred until the required controls are available.",
      "accessMode": "public",
      "workflowSlug": "sig_submission_workflow",
      "definition": {
        "schemaVersion": 1,
        "intro": "Use this form only for unclassified information. This foundation release accepts anonymous content submissions and does not collect identifying/contact information. Do not include classified information. If information is or may be classified, use an approved secure channel designated by SIG.",
        "submitLabel": "Submit to SIG",
        "confirmationMessage": "Your unclassified submission has been received. Save the confirmation information shown by the system. Protected submitter status and messaging are not yet enabled in this foundation release.",
        "sections": [
          {
            "id": "security_notice",
            "title": "Security Notice",
            "description": "The ordinary web intake is not an approved classified-information channel.",
            "fields": [
              {
                "id": "unclassified_attestation",
                "type": "attestation",
                "label": "Unclassified-information attestation",
                "required": true,
                "attestationText": "I understand that this web form is not an approved channel for classified information, and I will not submit classified information through it."
              },
              {
                "id": "good_faith_attestation",
                "type": "attestation",
                "label": "Good-faith attestation",
                "required": true,
                "attestationText": "I am submitting in good faith and believe the information may be relevant to United States national security or public safety."
              }
            ]
          },
          {
            "id": "submission",
            "title": "Submission",
            "description": "Describe the idea, innovation, vulnerability, operational insight, policy issue, or wrongdoing report you want SIG to evaluate.",
            "fields": [
              {
                "id": "submission_kind",
                "type": "select",
                "label": "Type of submission",
                "required": true,
                "options": [
                  {
                    "value": "technology_innovation",
                    "label": "Technology or invention"
                  },
                  {
                    "value": "security_vulnerability",
                    "label": "Security vulnerability"
                  },
                  {
                    "value": "wrongdoing_negligence",
                    "label": "Wrongdoing or negligence"
                  },
                  {
                    "value": "operational_insight",
                    "label": "Operational insight"
                  },
                  {
                    "value": "policy_governance",
                    "label": "Policy or governance suggestion"
                  },
                  {
                    "value": "other",
                    "label": "Other national-security-relevant information"
                  }
                ]
              },
              {
                "id": "primary_domain",
                "type": "select",
                "label": "Primary national security domain",
                "required": true,
                "options": [
                  {
                    "value": "defense_technology",
                    "label": "Defense Technology"
                  },
                  {
                    "value": "cybersecurity",
                    "label": "Cybersecurity"
                  },
                  {
                    "value": "intelligence_foreign_threats",
                    "label": "Intelligence & Foreign Threats"
                  },
                  {
                    "value": "homeland_law_enforcement",
                    "label": "Homeland Security & Law Enforcement"
                  },
                  {
                    "value": "science_technology",
                    "label": "Science & Technology Innovations"
                  },
                  {
                    "value": "policy_governance",
                    "label": "Policy & Governance"
                  },
                  {
                    "value": "other_multidomain",
                    "label": "Other / Multidomain"
                  }
                ]
              },
              {
                "id": "secondary_domains",
                "type": "multiselect",
                "label": "Additional relevant domains (optional)",
                "required": false,
                "options": [
                  {
                    "value": "defense_technology",
                    "label": "Defense Technology"
                  },
                  {
                    "value": "cybersecurity",
                    "label": "Cybersecurity"
                  },
                  {
                    "value": "intelligence_foreign_threats",
                    "label": "Intelligence & Foreign Threats"
                  },
                  {
                    "value": "homeland_law_enforcement",
                    "label": "Homeland Security & Law Enforcement"
                  },
                  {
                    "value": "science_technology",
                    "label": "Science & Technology Innovations"
                  },
                  {
                    "value": "policy_governance",
                    "label": "Policy & Governance"
                  }
                ]
              },
              {
                "id": "submission_title",
                "type": "short_text",
                "label": "Short title",
                "required": true,
                "validation": {
                  "minLength": 5,
                  "maxLength": 200
                }
              },
              {
                "id": "summary",
                "type": "long_text",
                "label": "Summary",
                "required": true,
                "helpText": "Summarize the core idea, issue, or warning.",
                "validation": {
                  "minLength": 25,
                  "maxLength": 3000
                }
              },
              {
                "id": "detailed_description",
                "type": "long_text",
                "label": "Detailed description",
                "required": true,
                "helpText": "Provide the technical, operational, factual, or policy detail needed for initial evaluation. Do not include classified information.",
                "validation": {
                  "minLength": 50,
                  "maxLength": 20000
                }
              },
              {
                "id": "national_security_relevance",
                "type": "long_text",
                "label": "Why is this relevant to national security or public safety?",
                "required": true,
                "validation": {
                  "minLength": 20,
                  "maxLength": 5000
                }
              }
            ]
          },
          {
            "id": "urgency",
            "title": "Urgency",
            "fields": [
              {
                "id": "urgency",
                "type": "select",
                "label": "How urgent is this submission?",
                "required": true,
                "options": [
                  {
                    "value": "routine",
                    "label": "Routine"
                  },
                  {
                    "value": "time_sensitive",
                    "label": "Time-sensitive"
                  },
                  {
                    "value": "immediate",
                    "label": "Immediate threat or critical vulnerability"
                  }
                ]
              },
              {
                "id": "urgency_details",
                "type": "long_text",
                "label": "Explain the immediate urgency",
                "required": true,
                "condition": {
                  "fieldId": "urgency",
                  "operator": "equals",
                  "value": "immediate"
                },
                "validation": {
                  "minLength": 20,
                  "maxLength": 5000
                }
              }
            ]
          },
          {
            "id": "intellectual_property",
            "title": "Intellectual Property and Proprietary Interests",
            "description": "The source proposal contemplates preserving patent, trade-secret, licensing, credit, and compensation interests. This field helps reviewers identify matters that may require specialized handling.",
            "fields": [
              {
                "id": "ip_interest",
                "type": "select",
                "label": "Does the submission involve intellectual-property or proprietary interests?",
                "required": true,
                "options": [
                  {
                    "value": "none",
                    "label": "No known IP or proprietary interest"
                  },
                  {
                    "value": "patent_invention",
                    "label": "Patent or invention interest"
                  },
                  {
                    "value": "trade_secret",
                    "label": "Trade secret"
                  },
                  {
                    "value": "other_proprietary",
                    "label": "Other proprietary information"
                  }
                ]
              },
              {
                "id": "ip_notes",
                "type": "long_text",
                "label": "Describe the IP or proprietary interest",
                "required": true,
                "condition": {
                  "fieldId": "ip_interest",
                  "operator": "not_equals",
                  "value": "none"
                },
                "validation": {
                  "minLength": 10,
                  "maxLength": 5000
                }
              }
            ]
          },
          {
            "id": "foundation_privacy_notice",
            "title": "Foundation Privacy Limitation",
            "description": "This foundation configuration deliberately does not collect a name, email address, phone number, affiliation, or other identity fields. The statutory confidential/pseudonymous and open-with-consent modes require identity/content segregation and controlled unmasking that are not yet available in the generic engine.",
            "fields": [
              {
                "id": "anonymous_mode_acknowledgment",
                "type": "attestation",
                "label": "Anonymous-mode acknowledgment",
                "required": true,
                "attestationText": "I understand that this foundation intake is anonymous and cannot yet provide protected follow-up communication or direct status messages."
              }
            ]
          }
        ]
      }
    }
  ],
