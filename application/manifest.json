  "communicationTemplates": [
    {
      "key": "submission_acknowledgment",
      "name": "Submission Acknowledgment",
      "channel": "portal",
      "subjectTemplate": "SIG submission {{case_number}} received",
      "bodyTemplate": "Your submission has been received and assigned tracking number {{case_number}}. SIG will review it and update the status when a protected submitter communication channel is available.",
      "defaultVisibility": "participant"
    },
    {
      "key": "additional_information_request",
      "name": "Additional Information Request",
      "channel": "portal",
      "subjectTemplate": "Additional information requested for {{case_number}}",
      "bodyTemplate": "SIG reviewers need additional information concerning {{case_number}}. Please use the protected SIG communication channel to respond.",
      "defaultVisibility": "participant"
    },
    {
      "key": "agency_referral_notice",
      "name": "Agency Referral Notice",
      "channel": "portal",
      "subjectTemplate": "Status update for {{case_number}}",
      "bodyTemplate": "SIG has referred {{case_number}} to an appropriate participating agency for evaluation. SIG remains the point of contact for this submission.",
      "defaultVisibility": "participant"
    },
    {
      "key": "agency_preliminary_update",
      "name": "Agency Preliminary Update",
      "channel": "portal",
      "subjectTemplate": "Agency update for {{case_number}}",
      "bodyTemplate": "SIG has received a preliminary agency assessment or action plan for {{case_number}}. Any releasable status information will be provided through the protected portal.",
      "defaultVisibility": "participant"
    },
    {
      "key": "closure_notice",
      "name": "Closure Notice",
      "channel": "portal",
      "subjectTemplate": "SIG case {{case_number}} closed",
      "bodyTemplate": "SIG case {{case_number}} has been closed with status {{case_status}}. Any releasable outcome information is available through the protected portal.",
      "defaultVisibility": "participant"
    }
  ],
  "workflows": [
    {
      "slug": "sig_submission_workflow",
      "name": "SIG Submission Lifecycle",
      "description": "Unclassified submission lifecycle from receipt through triage, expert review, referral, agency response tracking, resolution, and closure.",
      "definition": {
        "schemaVersion": 1,
        "initialState": "received",
        "states": [
          {
            "key": "received",
            "label": "Received"
          },
          {
            "key": "triage",
            "label": "Triage"
          },
          {
            "key": "urgent_review",
            "label": "Urgent Review"
          },
          {
            "key": "expert_review",
            "label": "Expert Panel Review"
          },
          {
            "key": "pending_submitter_information",
            "label": "Pending Submitter Information"
          },
          {
            "key": "referral_preparation",
            "label": "Referral Preparation"
          },
          {
            "key": "referred_to_agency",
            "label": "Referred to Agency"
          },
          {
            "key": "agency_preliminary_response",
            "label": "Agency Preliminary Response Received"
          },
          {
            "key": "agency_follow_up",
            "label": "Agency Follow-up"
          },
          {
            "key": "resolved",
            "label": "Resolved"
          },
          {
            "key": "closed_nongermane",
            "label": "Closed – Non-germane"
          },
          {
            "key": "closed_no_action",
            "label": "Closed – No Further Action"
          },
          {
            "key": "closed_duplicate",
            "label": "Closed – Duplicate / Merged"
          },
          {
            "key": "closed_resolved",
            "label": "Closed – Resolved"
          }
        ],
        "transitions": [
          {
            "key": "begin_triage",
            "label": "Begin Triage",
            "from": "received",
            "to": "triage",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "optional",
            "actions": [
              {
                "type": "mark_open"
              }
            ]
          },
          {
            "key": "close_nongermane",
            "label": "Close as Non-germane",
            "from": "triage",
            "to": "closed_nongermane",
            "requiredPermissions": [
              "case:close"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "set_disposition",
                "value": "Closed – Non-germane"
              },
              {
                "type": "mark_closed"
              }
            ]
          },
          {
            "key": "escalate_urgent",
            "label": "Escalate as Urgent",
            "from": "triage",
            "to": "urgent_review",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "set_priority",
                "value": "urgent"
              },
              {
                "type": "add_tag",
                "value": "urgent"
              }
            ]
          },
          {
            "key": "route_to_panel",
            "label": "Route to Expert Panel",
            "from": "triage",
            "to": "expert_review",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "add_tag",
                "value": "expert_review"
              }
            ]
          },
          {
            "key": "urgent_refer_to_agency",
            "label": "Urgent Referral to Agency",
            "from": "urgent_review",
            "to": "referred_to_agency",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "add_tag",
                "value": "urgent_referral"
              },
              {
                "type": "mark_open"
              }
            ]
          },
          {
            "key": "panel_request_more_information",
            "label": "Request More Information",
            "from": "expert_review",
            "to": "pending_submitter_information",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "required"
          },
          {
            "key": "resume_panel_review",
            "label": "Resume Expert Review",
            "from": "pending_submitter_information",
            "to": "expert_review",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "optional"
          },
          {
            "key": "prepare_positive_referral",
            "label": "Prepare Positive Referral",
            "from": "expert_review",
            "to": "referral_preparation",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "add_tag",
                "value": "positive_recommendation"
              }
            ]
          },
          {
            "key": "prepare_awareness_referral",
            "label": "Prepare Awareness / Verification Referral",
            "from": "expert_review",
            "to": "referral_preparation",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "add_tag",
                "value": "awareness_referral"
              }
            ]
          },
          {
            "key": "close_no_action",
            "label": "Close – No Further Action",
            "from": "expert_review",
            "to": "closed_no_action",
            "requiredPermissions": [
              "case:close"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "set_disposition",
                "value": "Closed – No further action"
              },
              {
                "type": "mark_closed"
              }
            ]
          },
          {
            "key": "close_duplicate",
            "label": "Close – Duplicate / Merged",
            "from": "expert_review",
            "to": "closed_duplicate",
            "requiredPermissions": [
              "case:close"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "set_disposition",
                "value": "Closed – Duplicate or merged with related submission"
              },
              {
                "type": "mark_closed"
              }
            ]
          },
          {
            "key": "refer_to_agency",
            "label": "Refer to Participating Agency",
            "from": "referral_preparation",
            "to": "referred_to_agency",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "required",
            "guards": {
              "requiredCaseFields": [
                "summary"
              ],
              "requiredSubmissionFields": [
                "submission_kind",
                "primary_domain",
                "national_security_relevance"
              ],
              "requiredDocuments": []
            },
            "actions": [
              {
                "type": "add_tag",
                "value": "agency_referred"
              }
            ]
          },
          {
            "key": "record_preliminary_agency_response",
            "label": "Record Preliminary Agency Response",
            "from": "referred_to_agency",
            "to": "agency_preliminary_response",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "required"
          },
          {
            "key": "continue_agency_follow_up",
            "label": "Continue Agency Follow-up",
            "from": "agency_preliminary_response",
            "to": "agency_follow_up",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "optional"
          },
          {
            "key": "resolve_from_preliminary",
            "label": "Resolve from Preliminary Response",
            "from": "agency_preliminary_response",
            "to": "resolved",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "mark_resolved"
              }
            ]
          },
          {
            "key": "record_final_agency_status",
            "label": "Record Final Agency Status",
            "from": "agency_follow_up",
            "to": "resolved",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "mark_resolved"
              }
            ]
          },
          {
            "key": "close_resolved",
            "label": "Close Resolved Case",
            "from": "resolved",
            "to": "closed_resolved",
            "requiredPermissions": [
              "case:close"
            ],
            "comment": "required",
            "actions": [
              {
                "type": "mark_closed"
              }
            ]
          }
        ],
        "deadlinePolicies": [
          {
            "key": "triage_target",
            "label": "Triage Target",
            "description": "Operational target to complete initial triage within 3 working days of receipt.",
            "trigger": {
              "type": "case_created"
            },
            "duration": {
              "value": 3,
              "unit": "business_days"
            },
            "warningBefore": {
              "value": 1,
              "unit": "business_days"
            },
            "calendarKey": "sig_business_calendar",
            "completeOnTransitions": [
              "close_nongermane",
              "escalate_urgent",
              "route_to_panel"
            ],
            "escalation": {
              "priority": "high",
              "queueSlug": "oversight_compliance"
            }
          },
          {
            "key": "initial_panel_review_target",
            "label": "Initial Expert Review Target",
            "description": "Operational target for the expert panel's initial review and recommendation.",
            "trigger": {
              "type": "transition",
              "transitionKey": "route_to_panel"
            },
            "duration": {
              "value": 10,
              "unit": "business_days"
            },
            "warningBefore": {
              "value": 2,
              "unit": "business_days"
            },
            "calendarKey": "sig_business_calendar",
            "completeOnTransitions": [
              "panel_request_more_information",
              "prepare_positive_referral",
              "prepare_awareness_referral",
              "close_no_action",
              "close_duplicate"
            ],
            "escalation": {
              "priority": "high",
              "queueSlug": "oversight_compliance"
            }
          },
          {
            "key": "resumed_panel_review_target",
            "label": "Resumed Expert Review Target",
            "trigger": {
              "type": "transition",
              "transitionKey": "resume_panel_review"
            },
            "duration": {
              "value": 10,
              "unit": "business_days"
            },
            "warningBefore": {
              "value": 2,
              "unit": "business_days"
            },
            "calendarKey": "sig_business_calendar",
            "completeOnTransitions": [
              "panel_request_more_information",
              "prepare_positive_referral",
              "prepare_awareness_referral",
              "close_no_action",
              "close_duplicate"
            ],
            "escalation": {
              "priority": "high",
              "queueSlug": "oversight_compliance"
            }
          },
          {
            "key": "agency_preliminary_response",
            "label": "Agency Preliminary Response",
            "description": "Participating agency preliminary assessment or action plan due within 30 days of routine referral.",
            "trigger": {
              "type": "transition",
              "transitionKey": "refer_to_agency"
            },
            "duration": {
              "value": 30,
              "unit": "calendar_days"
            },
            "warningBefore": {
              "value": 5,
              "unit": "calendar_days"
            },
            "completeOnTransitions": [
              "record_preliminary_agency_response"
            ],
            "escalation": {
              "priority": "high",
              "queueSlug": "oversight_compliance"
            }
          },
          {
            "key": "urgent_agency_preliminary_response",
            "label": "Urgent Agency Preliminary Response",
            "description": "Urgent-threat preliminary response target.",
            "trigger": {
              "type": "transition",
              "transitionKey": "urgent_refer_to_agency"
            },
            "duration": {
              "value": 72,
              "unit": "hours"
            },
            "warningBefore": {
              "value": 24,
              "unit": "hours"
            },
            "completeOnTransitions": [
              "record_preliminary_agency_response"
            ],
            "escalation": {
              "priority": "urgent",
              "queueSlug": "oversight_compliance"
            }
          },
          {
            "key": "agency_final_status",
            "label": "Agency Final Disposition or Status",
            "description": "Final disposition or substantive status update expected within 90 days of routine referral, subject to agreed extension for complex matters.",
            "trigger": {
              "type": "transition",
              "transitionKey": "refer_to_agency"
            },
            "duration": {
              "value": 90,
              "unit": "calendar_days"
