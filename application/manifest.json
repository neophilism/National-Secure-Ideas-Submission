{
  "schemaVersion": 1,
  "application": {
    "key": "secure_innovation_gateway",
    "name": "Secure Innovation Gateway",
    "shortName": "SIG",
    "description": "Application configuration for receiving, triaging, evaluating, referring, and tracking unclassified national-security-relevant submissions under the National Secure Ideas Submission Act of 2025.",
    "branding": {
      "accentColor": "#17365D",
      "homeTitle": "American Innovation Shield",
      "homeDescription": "Submit an unclassified national-security-relevant idea, innovation, vulnerability report, operational insight, or report of wrongdoing for SIG review. Do not submit classified information through this ordinary web form."
    },
    "terminology": {
      "case": {
        "singular": "SIG Case",
        "plural": "SIG Cases"
      },
      "submission": {
        "singular": "Submission",
        "plural": "Submissions"
      },
      "submitter": {
        "singular": "Submitter",
        "plural": "Submitters"
      },
      "review": {
        "singular": "Review",
        "plural": "Reviews"
      },
      "deadline": {
        "singular": "Response Deadline",
        "plural": "Response Deadlines"
      },
      "document": {
        "singular": "Case Document",
        "plural": "Case Documents"
      },
      "queue": {
        "singular": "Work Queue",
        "plural": "Work Queues"
      }
    }
  },
  "roles": [
    {
      "key": "sig_triage_officer",
      "name": "SIG Triage Officer",
      "description": "Screens incoming submissions, identifies urgency and scope, records triage context, and routes substantive matters for expert review.",
      "permissions": [
        "submission:view",
        "case:create",
        "case:view",
        "case:assign",
        "case:update",
        "deadline:view",
